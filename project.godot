; Engine configuration file.
; Godot 4.7 — Compatibility renderer so the same project runs on WebGL2 and desktop.

config_version=5

[application]

config/name="FRAGLINE"
config/description="A modern 2D arena shooter — tribute to the Newgrounds classic Unreal Flash."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.04, 0.07, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://src/autoload/settings.gd"
Sfx="*res://src/autoload/sfx.gd"
Music="*res://src/autoload/music.gd"
Net="*res://src/autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=60
2d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.07, 1)
textures/canvas_textures/default_texture_filter=1
